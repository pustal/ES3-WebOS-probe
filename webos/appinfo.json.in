{
    "id": "@PROBE_APP_ID@",
    "version": "@PROJECT_VERSION@",
    "vendor": "ES3 webOS probe",
    "type": "native",
    "main": "bin/es3probe",
    "title": "ES3 Probe",
    "icon": "icon.png",
    "largeIcon": "largeIcon.png",
